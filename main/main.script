function init(self)
	if tenjin then
		local sdk_key = sys.get_config_string("tenjin.sdk_key")

		tenjin.init(sdk_key, true)
		tenjin.set_customer_user_id(1)

		tenjin.custom_event("custom_event")
		tenjin.custom_event_with_value("custom_event", "10")
		tenjin.purchase_event("com.company.inapp", "USD", 1, 0.99)

		-- For purchases to appear in the Tenjin dashboard, pass the store receipt
		-- so Tenjin can verify them. Map the fields from the Google/Apple IAP response:
		-- Android:
		-- tenjin.purchase_event(response.ident, "USD", 1, 0.99, "", response.original_json, response.signature)

		-- For purchases made outside of Google Play (alternative stores / custom
		-- billing) there is no receipt to verify, report them server-to-server
		-- instead (Android only):
		-- tenjin.purchase_event_non_validated("com.company.inapp", "USD", 1, 0.99)
	end
end
